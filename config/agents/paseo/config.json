{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "relay": {
      "enabled": true,
      "endpoint": "relay.paseo.sh:443",
      "publicEndpoint": "relay.paseo.sh:443",
      "useTls": true,
      "publicUseTls": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "features": {
    "webUi": {
      "enabled": false
    }
  },
  "log": {
    "console": {
      "level": "info",
      "format": "json"
    },
    "file": {
      "level": "info",
      "path": "/srv/agents/paseo/daemon.log",
      "rotate": {
        "maxSize": "10M",
        "maxFiles": 5
      }
    }
  }
}
