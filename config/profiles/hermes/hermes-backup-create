#!/usr/bin/env bash
set -euo pipefail

die() { printf 'hermes backup create: %s\n' "$*" >&2; exit 1; }
if [ "$(id -u)" -ne 0 ] && [ "${HERMES_BACKUP_TEST_ALLOW_NON_ROOT:-0}" != 1 ]; then
  die "must run as root"
fi
backup_type="${1:-scheduled}"
case "$backup_type" in scheduled|pre-update|pre-teardown) ;; *) die "invalid backup type" ;; esac
stage_root="${HERMES_BACKUP_STAGE_ROOT:-/var/tmp}"
lock_path="${HERMES_BACKUP_LOCK_PATH:-/run/lock/subyard-hermes-backup.lock}"

runtime_env="${HERMES_RUNTIME_ENV:-/etc/subyard/hermes-runtime.env}"
[ -r "$runtime_env" ] || die "missing runtime contract"
# shellcheck disable=SC1090
. "$runtime_env"
HERMES_RUNTIME_ENV="$runtime_env" "$HERMES_PIN_CHECK" --runtime-only

exec 9>"$lock_path"
flock -n 9 || die "another backup is running"
if find "$stage_root" -maxdepth 1 -type d -name 'subyard-hermes-backup.*' -print -quit \
  | grep -q .; then
  die "a pending backup must be finalized first"
fi

service_was_active=0
systemctl is-active --quiet hermes-serve.service && service_was_active=1
systemctl stop hermes-serve.service
restore_on_error=1
stage=""
restore_service() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$restore_on_error" = 1 ] && [ "$service_was_active" = 1 ]; then
    systemctl start hermes-serve.service || true
  fi
  if [ "$status" -ne 0 ] && [ -n "$stage" ]; then
    printf 'hermes backup create: preserved failed staging at %s\n' "$stage" >&2
  fi
  exit "$status"
}
trap restore_service EXIT HUP INT TERM

if pgrep -u "$HERMES_DEV_USER" -f "$HERMES_VENV/bin/hermes" >/dev/null 2>&1; then
  die "a Hermes writer is still running after service stop"
fi

stage="$(mktemp -d "$stage_root/subyard-hermes-backup.XXXXXX")"
chmod 0700 "$stage"
chown "$HERMES_DEV_USER:$HERMES_DEV_GROUP" "$stage"
archive="$stage/hermes-backup.zip"
log="$stage/upstream.log"

if ! runuser -u "$HERMES_DEV_USER" -- env \
  HOME="$HERMES_DEV_HOME" HERMES_HOME="$HERMES_HOME" \
  HERMES_DISABLE_LAZY_INSTALLS=1 PATH="$HERMES_VENV/bin:/usr/local/bin:/usr/bin:/bin" \
  "$HERMES_VENV/bin/hermes" backup --output "$archive" >"$log" 2>&1; then
  die "upstream backup command failed"
fi
! grep -Fq 'Backup incomplete:' "$log" || die "upstream reported an incomplete backup"
grep -Fq 'Backup complete:' "$log" || die "upstream success marker missing"

verify="$HERMES_VERIFY_BACKUP"
verification="$("$verify" "$archive")"
sha="$(printf '%s\n' "$verification" | sed -n 's/^sha256=//p')"
size="$(printf '%s\n' "$verification" | sed -n 's/^size=//p')"
[ -n "$sha" ] && [ -n "$size" ] || die "archive verifier returned incomplete metadata"

metadata="$stage/metadata.env"
{
  printf 'yard=%s\n' "$(hostname)"
  printf 'created_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'hermes_version=%s\n' "$HERMES_VERSION"
  printf 'hermes_tag=%s\n' "$HERMES_TAG"
  printf 'hermes_commit=%s\n' "$HERMES_COMMIT"
  printf 'hermes_home=%s\n' "$HERMES_HOME"
  printf 'size=%s\n' "$size"
  printf 'sha256=%s\n' "$sha"
  printf 'service_was_active=%s\n' "$service_was_active"
  printf 'backup_type=%s\n' "$backup_type"
} > "$metadata"
printf '%s\n' "$service_was_active" > "$stage/.pending"
backup_owner=root
backup_group=root
if [ "$(id -u)" -ne 0 ]; then
  backup_owner="$HERMES_DEV_USER"
  backup_group="$HERMES_DEV_GROUP"
fi
chown -R "$backup_owner:$backup_group" "$stage"
chmod 0700 "$stage"
chmod 0600 "$archive" "$metadata" "$log" "$stage/.pending"

restore_on_error=0
trap - EXIT HUP INT TERM
printf 'BACKUP_DIR=%s\n' "$stage"
printf 'BACKUP_ZIP=%s\n' "$archive"
printf 'BACKUP_METADATA=%s\n' "$metadata"
printf 'BACKUP_SHA256=%s\n' "$sha"
