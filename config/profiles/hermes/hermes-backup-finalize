#!/usr/bin/env bash
set -euo pipefail

die() { printf 'hermes backup finalize: %s\n' "$*" >&2; exit 1; }
if [ "$(id -u)" -ne 0 ] && [ "${HERMES_BACKUP_TEST_ALLOW_NON_ROOT:-0}" != 1 ]; then
  die "must run as root"
fi
stage="${1:-}"
result="${2:-}"
stage_root="${HERMES_BACKUP_STAGE_ROOT:-/var/tmp}"
case "$stage" in "$stage_root"/subyard-hermes-backup.*) ;; *) die "invalid staging path" ;; esac
case "$result" in success|failure) ;; *) die "result must be success or failure" ;; esac
[ -d "$stage" ] && [ ! -L "$stage" ] && [ -r "$stage/.pending" ] \
  || die "pending staging directory not found"

service_was_active="$(<"$stage/.pending")"
case "$service_was_active" in 0|1) ;; *) die "invalid saved service state" ;; esac

if [ "$result" = success ]; then
  rm -rf -- "$stage"
else
  printf 'hermes backup finalize: preserving %s after failure\n' "$stage" >&2
fi
if [ "$service_was_active" = 1 ]; then
  systemctl start hermes-serve.service
fi
