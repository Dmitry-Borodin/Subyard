#!/usr/bin/env bash
set -euo pipefail

die() { printf 'hermes restore: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root"
archive="${1:-}"
expected_sha="${2:-}"
[ -n "$archive" ] && [ -n "$expected_sha" ] \
  || die "usage: hermes-restore ZIP SHA256"

runtime_env="${HERMES_RUNTIME_ENV:-/etc/subyard/hermes-runtime.env}"
[ -r "$runtime_env" ] || die "missing runtime contract"
# shellcheck disable=SC1090
. "$runtime_env"
HERMES_RUNTIME_ENV="$runtime_env" "$HERMES_PIN_CHECK" --runtime-only
"$HERMES_VERIFY_BACKUP" "$archive" "$expected_sha" >/dev/null

systemctl stop hermes-serve.service
systemctl disable hermes-serve.service >/dev/null 2>&1 || true
rm -f -- "$HERMES_HOME/.provider-ready"

restore_stage="$(mktemp -d /var/tmp/subyard-hermes-restore.XXXXXX)"
trap 'rm -rf -- "$restore_stage"' EXIT
chown "$HERMES_DEV_USER:$HERMES_DEV_GROUP" "$restore_stage"
install -m 0600 -o "$HERMES_DEV_USER" -g "$HERMES_DEV_GROUP" \
  "$archive" "$restore_stage/hermes-backup.zip"
runuser -u "$HERMES_DEV_USER" -- env \
  HOME="$HERMES_DEV_HOME" HERMES_HOME="$HERMES_HOME" \
  HERMES_DISABLE_LAZY_INSTALLS=1 PATH="$HERMES_VENV/bin:/usr/local/bin:/usr/bin:/bin" \
  "$HERMES_VENV/bin/hermes" import "$restore_stage/hermes-backup.zip" --force
rm -rf -- "$restore_stage"
trap - EXIT

chown -R "$HERMES_DEV_USER:$HERMES_DEV_GROUP" "$HERMES_HOME"
chmod 0700 "$HERMES_HOME" "$HERMES_HOME/workspace"
find "$HERMES_HOME" -type f \( -name '*.env' -o -name 'auth.json' -o -name 'state.db' \) \
  -exec chmod 0600 {} +
rm -f -- "$HERMES_HOME/.provider-ready" "$HERMES_HOME/.last-verified-backup"
printf 'hermes restore OK: provider approval was invalidated; run doctor and real inference again\n'
