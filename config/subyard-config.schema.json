{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dmitry-Borodin/Subyard/config/subyard-config.schema.json",
  "title": "Subyard versioned desired configuration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "description": "Reserved for a future schema. Schema 1 accepts no policy keys.",
      "maxProperties": 0
    }
  }
}
