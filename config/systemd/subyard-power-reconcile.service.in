[Unit]
Description=Restore guarded Subyard desired power state
Wants=network-online.target
After=network-online.target NetworkManager.service incus.service incus.socket
StartLimitIntervalSec=15min
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=@SUBYARD_POWER_RECONCILER@ _power-reconcile
TimeoutStartSec=120
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
