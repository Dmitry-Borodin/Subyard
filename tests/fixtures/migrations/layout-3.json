{
  "schemaVersion": 1,
  "minimumLayout": 1,
  "currentLayout": 3,
  "migrations": [
    {
      "id": "move-legacy-assignments",
      "fromLayout": 1,
      "toLayout": 2,
      "resources": ["migration-fixture-assignments"],
      "finalizePolicy": "remove-source-after-active-verify",
      "rollbackPolicy": "restore-recovery-before-runtime-swap",
      "moves": [
        {
          "scope": "config-home",
          "source": "migration-fixture/legacy/config.env",
          "destination": "migration-fixture/current/config.env",
          "consumer": "assignments"
        }
      ]
    },
    {
      "id": "rotate-current-assignments",
      "fromLayout": 2,
      "toLayout": 3,
      "resources": ["migration-fixture-assignments"],
      "finalizePolicy": "remove-source-after-active-verify",
      "rollbackPolicy": "restore-recovery-before-runtime-swap",
      "moves": [
        {
          "scope": "config-home",
          "source": "migration-fixture/current/config.env",
          "destination": "migration-fixture/final/config.env",
          "consumer": "assignments"
        }
      ]
    }
  ]
}
